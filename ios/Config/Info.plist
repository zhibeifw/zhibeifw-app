<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<!-- 小组件共享数据的 App Group（开发版、正式版各一个，在工程设置 ZBFW_APP_GROUP 里） -->
	<key>ZBFWAppGroup</key>
	<string>$(ZBFW_APP_GROUP)</string>
	<!-- 点小组件打开 App 用的链接 zhibeifw:// -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.zhibeifw.app.widget</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>zhibeifw</string>
			</array>
		</dict>
	</array>
	<!-- 长按 App 图标弹出的菜单：最近播放、收藏、已下载（和资料库里的名字、图标一样） -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.zhibeifw.app.recent</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>最近播放</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>clock</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.zhibeifw.app.favorites</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>收藏</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>bookmark</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.zhibeifw.app.downloads</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>已下载</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>arrow.down.circle</string>
		</dict>
	</array>
	<key>ZBFWCloudContainer</key>
	<string>iCloud.com.zhibeifw.app</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
</dict>
</plist>
