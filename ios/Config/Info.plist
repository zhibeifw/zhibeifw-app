<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<!-- 小组件共享数据的 App Group（开发版、正式版各一个，在工程设置 ZBFW_APP_GROUP 里） -->
	<key>ZBFWAppGroup</key>
	<string>$(ZBFW_APP_GROUP)</string>
	<!-- 点小组件打开 App 用的链接 zhibeifw:// -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.zhibeifw.app.widget</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>zhibeifw</string>
			</array>
		</dict>
	</array>
	<key>ZBFWCloudContainer</key>
	<string>iCloud.com.zhibeifw.app</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
</dict>
</plist>
