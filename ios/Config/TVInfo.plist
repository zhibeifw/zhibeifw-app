<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Apple TV 版的 Info.plist（其余键由 Xcode 按 INFOPLIST_KEY_* 生成）。后台播放：按 Home 键回到桌面后接着播。 -->
<plist version="1.0">
<dict>
    <key>INIntentsSupported</key>
    <array><string>INPlayMediaIntent</string></array>
    <key>INSupportedMediaCategories</key>
    <array><string>INMediaCategoryGeneral</string><string>INMediaCategoryPodcasts</string></array>
    <key>NSSiriUsageDescription</key>
    <string>将课程名称、集数和播放请求提供给 Siri，用于按你的语音指令收听课程。</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<key>ZBFWCloudContainer</key>
	<string>iCloud.com.zhibeifw.app</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
</dict>
</plist>
