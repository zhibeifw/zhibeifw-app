<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Zhibei" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- 启动页：浅色白底、深色黑底（values-night），Logo 居中 -->
    <style name="Theme.Zhibei.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Zhibei</item>
    </style>
</resources>
