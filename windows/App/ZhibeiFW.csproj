<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>智悲佛网</AssemblyName>
    <RootNamespace>Zhibei.Desktop</RootNamespace>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <Company>智悲佛网</Company>
    <Product>智悲佛网</Product>
    <VersionConfig>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../Version.xcconfig'))</VersionConfig>
    <Version>$([System.Text.RegularExpressions.Regex]::Match('$(VersionConfig)', '(?m)^MARKETING_VERSION\s*=\s*([\d.]+)').Groups[1].Value)</Version>
    <BuildNumber>$([System.Text.RegularExpressions.Regex]::Match('$(VersionConfig)', '(?m)^CURRENT_PROJECT_VERSION\s*=\s*(\d+)').Groups[1].Value)</BuildNumber>
    <FileVersion>$(Version).$([System.Text.RegularExpressions.Regex]::Match('$(BuildNumber)', '\d{2}$').Value)</FileVersion>
    <InformationalVersion>$(Version)+$(BuildNumber)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Core.csproj"/>
    <Resource Include="App.ico"/>
    <Resource Include="../../ios/ZhibeiFWMac/Resources/Assets.xcassets/Logo.imageset/logo.png" Link="LaunchLogo.png"/>
    <EmbeddedResource Include="../../doc/icons.json" LogicalName="catalog-icons.json"/>
    <EmbeddedResource Include="../../doc/design-tokens.json" LogicalName="design.json"/>
  </ItemGroup>
</Project>
